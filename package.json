{
  "name": "grap-local",
  "version": "0.1.0",
  "private": true,
  "description": "Local-first code context engine for repository indexing, graph retrieval, and MCP access.",
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/src/server.js",
    "lint": "eslint .",
    "test": "vitest run",
    "index": "tsx scripts/index.ts",
    "mcp": "tsx src/modules/mcp/server.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.1",
    "dotenv": "^16.4.5",
    "express": "^4.21.2",
    "ignore": "^7.0.4",
    "mongoose": "^8.13.2",
    "pino": "^9.6.0",
    "pino-http": "^10.4.0",
    "ts-morph": "^25.0.1",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.24.0",
    "@types/express": "^5.0.1",
    "@types/node": "^22.14.1",
    "@types/supertest": "^6.0.3",
    "@vitest/coverage-v8": "^3.1.1",
    "eslint": "^9.24.0",
    "eslint-config-prettier": "^10.1.1",
    "mongodb-memory-server": "^11.0.1",
    "prettier": "^3.5.3",
    "supertest": "^7.1.0",
    "tsx": "^4.19.3",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.29.1",
    "vitest": "^3.1.1"
  }
}
